# Copy to .env and fill in.

# Used by scripts/ at build time only; never referenced from src/.
MARKETSTACK_KEY=
GEMINI_KEY=
GEMINI_PROJECT=

# Read by src/lib/gemini.ts. Anything prefixed VITE_ is inlined into the
# browser bundle and is therefore public once the site is deployed. Restrict
# this key to the Generative Language API and to your site's referrer.
VITE_GEMINI_KEY=
